<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.naitikgupta.wingman.history-watch</string>

  <key>ProgramArguments</key>
  <array>
    <string>__WINGMAN_HISTORY_BINARY__</string>
    <string>watch</string>
    <string>--acknowledge-sensitive-data</string>
  </array>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ProcessType</key>
  <string>Background</string>

  <key>StandardOutPath</key>
  <string>__WINGMAN_LOG_DIR__/history-watch.out.log</string>
  <key>StandardErrorPath</key>
  <string>__WINGMAN_LOG_DIR__/history-watch.err.log</string>
</dict>
</plist>
