// Copy this file to Secrets.xcconfig (gitignored) and fill in real values.
// xcodegen wires Secrets.xcconfig into the Wingman and WingmanMessages
// targets' Info.plist so the app can read it at runtime via
// Bundle.main.object(forInfoDictionaryKey:). Never commit the real file.

NVIDIA_API_KEY = nvapi-REPLACE_ME

// Optional. When set, reply drafts use Render Workflows through the gateway.
// Leave this placeholder unchanged to use the direct NIM fallback.
RENDER_WORKFLOW_URL = https:/$()/your-gateway.onrender.com
